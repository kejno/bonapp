    "attachResponseAsFile": false,
    "skipAIProcessing": true,
    "alwaysPostComments": true,
    "envVariables": {
      "CLI_ALLOWED_COMMANDS": "find,ls,cat,mkdir,bash,npm,npx,git,run-agent.sh",
