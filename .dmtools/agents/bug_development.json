{
  "name": "Teammate",
  "params": {
    "metadata": {
      "contextId": "bug_development",
      "descriptionPath": "agents/docs/agents/bug_development.md"
    },
    "cliCommands": [
      "./agents/scripts/run-agent.sh"
    ],
    "outputType": "none",
