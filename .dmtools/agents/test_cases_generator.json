{
  "name": "Teammate",
  "params": {
    "metadata": {
      "contextId": "test_cases_generator",
      "descriptionPath": "agents/docs/agents/test_cases_generator.md"
    },
    "cliCommands": [
      "./agents/scripts/run-agent.sh"
    ],
    "outputType": "none",
    "ticketContextDepth": 1,
    "skipAIProcessing": true,
    "alwaysPostComments": true,
    "envVariables": {
      "CLI_ALLOWED_COMMANDS": "find,ls,cat,mkdir,bash,run-agent.sh"
    },
    "preJSAction": "agents/js/moveToReadyForTesting.js",
    "postJSAction": "agents/js/finishTestCasesGeneration.js",
    "inputJql": "key = SCRUM-11",
    "cliPrompts": [
      "Senior QA Engineer specializing in test case design",
      "./agents/instructions/common/agent_task_preamble.md",
      "./agents/instructions/common/input_context_reading.md",
      "./agents/instructions/test_cases/test_case_creation_rules.md",
      "./agents/instructions/test_cases/test_case_relation_rules.md",
      "./agents/instructions/test_cases_generator/workflow.md",
      "./agents/prompts/bash_tools.md",
      "./agents/instructions/common/dmtools_cli.md"
    ],
    "cliPromptsByTracker": {
      "jira": [
        "./agents/instructions/tracker/jira_comment_format.md"
      ]
    }
  }
}
