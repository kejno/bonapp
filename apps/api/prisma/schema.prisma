generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
  tables Table[]
  menuCategories MenuCategory[]
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String @unique
  role     String

  @@index([tenantId])
}

model Table {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  number    Int
  sessions  TableSession[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model TableSession {
  id        String   @id @default(uuid())
  token     String   @unique
  tenantId  String
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id])
  isActive  Boolean  @default(true)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([tenantId, tableId])
}

model MenuCategory {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int    @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  dishes    Dish[]

  @@index([tenantId, sortOrder])
}

model Dish {
  id         String       @id @default(uuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  name       String
  description String?
  price      Int
  imageUrl   String?
  isActive   Boolean      @default(true) @map("is_active")
  isHit      Boolean      @default(false) @map("is_hit")
  sortOrder  Int          @default(0) @map("sort_order")
  modifiers  DishModifier[]
  stopListEntries StopListEntry[]

  @@index([categoryId, sortOrder])
}

model DishModifier {
  id         String @id @default(uuid())
  dishId     String
  dish       Dish   @relation(fields: [dishId], references: [id])
  name       String
  priceDelta Int    @default(0)
  sortOrder  Int    @default(0) @map("sort_order")

  @@index([dishId, sortOrder])
}

model StopListEntry {
  id        String   @id @default(uuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id])
  expiresAt DateTime?

  @@index([dishId])
}
