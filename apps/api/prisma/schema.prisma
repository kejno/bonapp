generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  email        String  @unique
  role         String
  passwordHash String?
  pinHash      String?
  totpSecret   String?
  totpEnabled  Boolean @default(false)

  @@index([tenantId])
}
