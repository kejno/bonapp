generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PaymentMethod {
  OPLATI
  ERIP
  CARD
  CASH
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Europe/Minsk")
  createdAt DateTime @default(now())

  users               User[]
  tables              Table[]
  menuItems           MenuItem[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
  tips                Tip[]
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String @unique
  role     String

  @@index([tenantId])
}

model Table {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isActive Boolean @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@index([tenantId])
}

model MenuItem {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  price    Decimal
  isActive Boolean @default(true)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]

  @@index([tenantId])
}

model Order {
  id        String      @id @default(uuid())
  tenantId  String
  tableId   String
  waiterId  String?
  status    OrderStatus @default(OPEN)
  total     Decimal     @default(0)
  createdAt DateTime    @default(now())
  closedAt  DateTime?

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  table    Table                @relation(fields: [tableId], references: [id])
  items    OrderItem[]
  payments PaymentTransaction[]
  tips     Tip[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal
  name       String

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model PaymentTransaction {
  id        String        @id @default(uuid())
  orderId   String
  tenantId  String
  method    PaymentMethod
  amount    Decimal
  createdAt DateTime      @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Tip {
  id        String   @id @default(uuid())
  orderId   String
  tenantId  String
  waiterId  String
  amount    Decimal
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, waiterId])
  @@index([tenantId, createdAt])
}
