generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  legalName String
  unp       String   @unique
  address   String
  timezone  String   @default("Europe/Minsk")
  brandColor String  @default("#e0533c")
  logoUrl   String?
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String @unique
  role     String

  @@index([tenantId])
}
