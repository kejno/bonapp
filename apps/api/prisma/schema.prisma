generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  ERIP
  BEPAID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  tables   Table[]
  orders   Order[]
  payments Payment[]
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String @unique
  role     String

  @@index([tenantId])
}

model Table {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  number   Int
  orders   Order[]

  @@index([tenantId])
}

model Order {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  tableId        String
  table          Table     @relation(fields: [tableId], references: [id])
  tableSessionId String
  amount         Int
  currency       String    @default("BYN")
  is_paid        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([tenantId])
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Int
  currency       String        @default("BYN")
  gatewayRef     String?
  checkoutUrl    String?
  webhookPayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([orderId])
  @@index([gatewayRef])
}
