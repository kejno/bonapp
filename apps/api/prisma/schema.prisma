generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  posConnectors  PosConnector[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  email    String @unique
  role     String

  @@index([tenantId])
}

enum PosType {
  RKEEPER
  IIKO
}

enum OrderStatus {
  PENDING
  SENT_TO_POS
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PosConnector {
  id                String   @id @default(uuid())
  tenantId          String
  posType           PosType
  baseUrl           String
  username          String
  passwordEncrypted String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, posType])
  @@index([tenantId])
}

model MenuCategory {
  id            String     @id @default(uuid())
  tenantId      String
  name          String
  posCategoryId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  menuItems     MenuItem[]

  @@index([tenantId])
  @@index([tenantId, posCategoryId])
}

model MenuItem {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  price       Decimal
  posItemId   String?
  categoryId  String?
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  category    MenuCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([tenantId])
  @@index([tenantId, posItemId])
}

model Order {
  id         String      @id @default(uuid())
  tenantId   String
  posOrderId String?
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  items      OrderItem[]

  @@index([tenantId])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}
