generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  WAITER
  CHEF
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLOSED
}

model Tenant {
  id               String       @id @default(uuid())
  slug             String       @unique
  name             String
  legalName        String?      @map("legal_name")
  unp              String?
  address          String?
  timezone         String       @default("Europe/Minsk")
  currency         String       @default("BYN")
  logoUrl          String?      @map("logo_url")
  brandColor       String?      @map("brand_color")
  dineIn           Boolean      @default(true) @map("dine_in")
  takeaway         Boolean      @default(false)
  delivery         Boolean      @default(false)
  isActive         Boolean      @default(true) @map("is_active")
  trialEndsAt      DateTime?    @map("trial_ends_at")
  subscriptionPlan String       @default("free") @map("subscription_plan")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  users            User[]
  diningAreas      DiningArea[]
  tables           Table[]
  orders           Order[]
  payments         Payment[]

  @@map("tenants")
}

model User {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  phone          String?
  role           UserRole
  pinCode        String?   @map("pin_code")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  assignedOrders Order[]   @relation("AssignedWaiterOrders")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

model DiningArea {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tables    Table[]

  @@index([tenantId])
  @@map("dining_areas")
}

model Table {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  areaId      String      @map("area_id")
  area        DiningArea  @relation(fields: [areaId], references: [id])
  tableNumber Int         @map("table_number")
  label       String?
  seatsCount  Int         @default(1) @map("seats_count")
  qrToken     String      @unique @map("qr_token")
  posTableId  String?     @map("pos_table_id")
  status      TableStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now()) @map("created_at")

  orders      Order[]

  @@unique([id, tenantId])
  @@unique([tenantId, tableNumber])
  @@index([qrToken], map: "idx_tables_qr_token")
  @@index([tenantId])
  @@index([areaId])
  @@map("tables")
}

enum OrderStatus {
  NEW
  COOKING
  READY
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  OPLATI_QR
  ERIP_EPOS
  BANK_CARD
  CASH_TO_WAITER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  tableId          String         @map("table_id")
  table            Table          @relation(fields: [tableId, tenantId], references: [id, tenantId])
  dailyOrderNumber Int            @map("daily_order_number")
  status           OrderStatus    @default(NEW)
  guestSessionId   String?        @map("guest_session_id")
  assignedWaiterId String?        @map("assigned_waiter_id")
  assignedWaiter   User?          @relation("AssignedWaiterOrders", fields: [assignedWaiterId, tenantId], references: [id, tenantId], onDelete: Restrict)
  totalAmountByn   Decimal        @default(0) @map("total_amount_byn") @db.Decimal(12, 2)
  tipsAmountByn    Decimal        @default(0) @map("tips_amount_byn") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod? @map("payment_method")
  isPaid           Boolean        @default(false) @map("is_paid")
  paidAt           DateTime?      @map("paid_at")
  posOrderId       String?        @map("pos_order_id")
  comment          String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  items            OrderItem[]
  payments         Payment[]

  @@unique([id, tenantId])
  @@index([tenantId, status], map: "idx_orders_tenant_status")
  @@index([tableId], map: "idx_orders_table_id")
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId            String  @map("item_id")
  quantity          Int
  unitPriceByn      Decimal @map("unit_price_byn") @db.Decimal(12, 2)
  selectedModifiers Json    @map("selected_modifiers")
  itemComment       String? @map("item_comment")
  status            String
  kitchenDepartment String  @map("kitchen_department")

  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  orderId               String        @map("order_id")
  order                 Order         @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  amountByn             Decimal       @map("amount_byn") @db.Decimal(12, 2)
  tipsAmountByn         Decimal       @default(0) @map("tips_amount_byn") @db.Decimal(12, 2)
  provider              String
  providerTransactionId String?       @map("provider_transaction_id")
  eripOrderNumber       String?       @map("erip_order_number")
  status                PaymentStatus @default(PENDING)
  fiscalReceiptNumber   String?       @map("fiscal_receipt_number")
  payload               Json?
  createdAt             DateTime      @default(now()) @map("created_at")

  @@map("payments")
}
