PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bonapp
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Payment provider will be selected in a separate task.
PAYMENT_PUBLIC_KEY=replace-with-payment-public-key
PAYMENT_SECRET_KEY=replace-with-payment-secret-key

# S3-compatible object storage (MinIO for local dev, S3-compatible for production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bonapp
# Public-facing base URL for stored objects (same as S3_ENDPOINT for MinIO)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
